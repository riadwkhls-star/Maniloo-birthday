<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maniloo's 1st Birthday | Disney Stitch Party</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@600;700;800&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background: #030b1e;
            color: #f0f9ff;
            overflow-x: hidden;
        }
        .stitch-font {
            font-family: 'Fredoka', cursive;
        }
        .heading-font {
            font-family: 'Outfit', sans-serif;
        }
        .bg-ocean-gradient {
            background: radial-gradient(circle at 50% 20%, #1e40af 0%, #0f172a 70%, #030b1e 100%);
        }
        .card-glass {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            border: 2px solid rgba(56, 189, 248, 0.3);
        }
        .stitch-blue-glow {
            box-shadow: 0 0 35px rgba(37, 99, 235, 0.45);
        }
        .text-glow {
            text-shadow: 0 0 12px rgba(56, 189, 248, 0.6);
        }
        
        /* Floating Animation */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(1.5deg); }
        }
        .animate-float {
            animation: float 4s ease-in-out infinite;
        }

        /* Hibiscus Petal Falling Animation */
        @keyframes petalFall {
            0% { transform: translateY(-10vh) rotate(0deg); opacity: 0.8; }
            100% { transform: translateY(100vh) rotate(360deg); opacity: 0; }
        }
        .petal {
            position: fixed;
            top: -10%;
            pointer-events: none;
            z-index: 50;
            animation: petalFall 8s linear infinite;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #2563eb;
            border-radius: 4px;
        }

        @media print {
            .no-print { display: none !important; }
            body { background: white !important; color: black !important; }
        }
    </style>
</head>
<body class="bg-ocean-gradient min-h-screen relative selection:bg-cyan-500 selection:text-white">

    <!-- Falling Petals Container -->
    <div id="petals-container" class="no-print"></div>

    <!-- Music / Sound Control -->
    <div class="fixed top-4 right-4 z-50 no-print">
        <button id="musicToggleBtn" onclick="toggleAudio()" class="card-glass hover:bg-blue-900/80 p-3 rounded-full text-cyan-300 shadow-lg transition transform active:scale-95 flex items-center gap-2 border border-cyan-400/40">
            <span id="musicIcon" class="text-xl">🎵</span>
            <span id="musicText" class="text-xs font-bold hidden sm:inline text-cyan-200">Play Beach Vibes</span>
        </button>
    </div>

    <!-- HERO SECTION -->
    <section class="relative min-h-screen flex flex-col items-center justify-center p-4 sm:p-8 text-center overflow-hidden">
        
        <!-- Tropical Leaves Background Elements -->
        <div class="absolute top-10 left-5 w-32 h-32 text-cyan-500/10 pointer-events-none animate-pulse">
            <svg viewBox="0 0 100 100" fill="currentColor"><path d="M10 50 Q30 10 70 10 Q50 50 10 50 Z"/><path d="M20 70 Q10 30 50 20 Q40 60 20 70 Z"/></svg>
        </div>
        <div class="absolute bottom-10 right-5 w-40 h-40 text-blue-500/10 pointer-events-none animate-pulse">
            <svg viewBox="0 0 100 100" fill="currentColor"><path d="M10 50 Q30 10 70 10 Q50 50 10 50 Z"/><path d="M20 70 Q10 30 50 20 Q40 60 20 70 Z"/></svg>
        </div>

        <!-- Header Tag -->
        <div class="inline-flex items-center gap-2 bg-blue-600/30 border border-cyan-400/50 px-5 py-2 rounded-full text-cyan-300 text-xs sm:text-sm font-bold tracking-widest uppercase mb-4 shadow-lg backdrop-blur-md">
            <span>🌺</span> Disney Stitch Theme <span>🌺</span>
        </div>

        <p class="stitch-font text-cyan-300 text-2xl sm:text-3xl tracking-wide uppercase text-glow">
            Aloha! You're Invited To
        </p>

        <!-- Big Title -->
        <h1 class="heading-font text-5xl sm:text-7xl lg:text-8xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-200 via-sky-300 to-blue-400 my-2 drop-shadow-xl">
            MANILOO'S
        </h1>
        
        <div class="inline-block bg-gradient-to-r from-blue-600 to-cyan-500 text-white stitch-font text-2xl sm:text-4xl px-6 py-1.5 rounded-2xl rotate-[-2deg] shadow-lg mb-6">
            1st Birthday Party! 🎂
        </div>

        <!-- MAIN STITCH CHARACTER IMAGE CONTAINER -->
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 my-2 animate-float flex items-center justify-center">
            <!-- Glow background circle -->
            <div class="absolute inset-0 bg-blue-500/30 rounded-full blur-3xl -z-10"></div>
            
            <!-- Picture Box -->
            <div class="relative w-full h-full rounded-3xl overflow-hidden border-4 border-cyan-300/80 stitch-blue-glow bg-blue-950/40 backdrop-blur-sm p-2 flex flex-col items-center justify-center">
                <img id="stitchImage" src="https://i.imghippo.com/files/rTr2460UCQ.png" 
                     alt="Stitch Character" class="w-full h-full object-contain drop-shadow-lg" />
            </div>
        </div>

        <p class="stitch-font text-blue-200 text-lg sm:text-xl max-w-md my-4">
            "'Ohana means family, and family means nobody gets left behind or forgotten!"
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 justify-center mt-2 no-print">
            <a href="#gallery-section" class="bg-gradient-to-r from-cyan-400 to-blue-600 hover:from-cyan-300 hover:to-blue-500 text-white font-bold text-base px-8 py-3.5 rounded-2xl shadow-lg hover:shadow-cyan-500/50 transition transform hover:-translate-y-1">
                📷 BABY PHOTOS
            </a>
            <a href="#details-section" class="card-glass hover:bg-slate-800 text-cyan-300 font-bold text-base px-8 py-3.5 rounded-2xl border border-cyan-400/40 transition">
                📍 PARTY DETAILS
            </a>
        </div>
    </section>

    <!-- BABY PHOTO GALLERY SECTION -->
    <section id="gallery-section" class="py-12 px-4 max-w-4xl mx-auto text-center">
        <div class="mb-8">
            <div class="inline-block bg-blue-900/60 border border-cyan-400/40 px-4 py-1 rounded-full text-cyan-300 text-xs font-bold uppercase tracking-widest mb-2">
                👶 Maniloo's First Year
            </div>
            <h2 class="stitch-font text-3xl sm:text-5xl text-cyan-300">
                Baby Photo Gallery 📸
            </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            
            <!-- Baby Photo 1 -->
            <div class="card-glass p-3 rounded-3xl border-2 border-cyan-400/40 stitch-blue-glow relative flex flex-col items-center group">
                <div class="relative w-full h-48 rounded-2xl overflow-hidden bg-blue-950/60 border border-cyan-300/30 flex items-center justify-center">
                    <img id="babyImg1" src="https://i.imghippo.com/files/UioE1078eg.jpg" alt="Baby Photo 1" class="w-full h-full object-cover">
                    <span class="absolute top-2 left-2 bg-blue-900/80 text-cyan-300 text-[10px] font-bold px-2 py-0.5 rounded-md border border-cyan-400/30">Baby Photo #1</span>
                </div>
            </div>

            <!-- Baby Photo 2 -->
            <div class="card-glass p-3 rounded-3xl border-2 border-cyan-400/40 stitch-blue-glow relative flex flex-col items-center group">
                <div class="relative w-full h-48 rounded-2xl overflow-hidden bg-blue-950/60 border border-cyan-300/30 flex items-center justify-center">
                    <img id="babyImg2" src="https://i.imghippo.com/files/tyk7856Vcs.jpg" alt="Baby Photo 2" class="w-full h-full object-cover">
                    <span class="absolute top-2 left-2 bg-blue-900/80 text-cyan-300 text-[10px] font-bold px-2 py-0.5 rounded-md border border-cyan-400/30">Baby Photo #2</span>
                </div>
            </div>

            <!-- Baby Photo 3 -->
            <div class="card-glass p-3 rounded-3xl border-2 border-cyan-400/40 stitch-blue-glow relative flex flex-col items-center group">
                <div class="relative w-full h-48 rounded-2xl overflow-hidden bg-blue-950/60 border border-cyan-300/30 flex items-center justify-center">
                    <img id="babyImg3" src="https://i.imghippo.com/files/mAKm8973b.jpg" alt="Baby Photo 3" class="w-full h-full object-cover">
                    <span class="absolute top-2 left-2 bg-blue-900/80 text-cyan-300 text-[10px] font-bold px-2 py-0.5 rounded-md border border-cyan-400/30">Baby Photo #3</span>
                </div>
            </div>

        </div>
    </section>

    <!-- LIVE COUNTDOWN TIMER -->
    <section class="py-8 bg-blue-950/60 border-y border-cyan-500/30 backdrop-blur-md no-print">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h3 class="stitch-font text-cyan-300 text-lg sm:text-xl tracking-wider uppercase mb-4">
                ⏳ Countdown To Maniloo's Party ⏳
            </h3>
            <div id="countdown" class="grid grid-cols-4 gap-2 sm:gap-6 max-w-lg mx-auto">
                <div class="card-glass p-3 sm:p-4 rounded-2xl border border-cyan-400/30">
                    <span id="cd-days" class="heading-font text-2xl sm:text-4xl font-extrabold text-cyan-200">00</span>
                    <span class="block text-xs uppercase text-blue-300 font-semibold mt-1">Days</span>
                </div>
                <div class="card-glass p-3 sm:p-4 rounded-2xl border border-cyan-400/30">
                    <span id="cd-hours" class="heading-font text-2xl sm:text-4xl font-extrabold text-cyan-200">00</span>
                    <span class="block text-xs uppercase text-blue-300 font-semibold mt-1">Hours</span>
                </div>
                <div class="card-glass p-3 sm:p-4 rounded-2xl border border-cyan-400/30">
                    <span id="cd-mins" class="heading-font text-2xl sm:text-4xl font-extrabold text-cyan-200">00</span>
                    <span class="block text-xs uppercase text-blue-300 font-semibold mt-1">Mins</span>
                </div>
                <div class="card-glass p-3 sm:p-4 rounded-2xl border border-cyan-400/30">
                    <span id="cd-secs" class="heading-font text-2xl sm:text-4xl font-extrabold text-cyan-200">00</span>
                    <span class="block text-xs uppercase text-blue-300 font-semibold mt-1">Secs</span>
                </div>
            </div>
        </div>
    </section>

    <!-- PARTY DETAILS SECTION -->
    <section id="details-section" class="py-16 px-4 max-w-4xl mx-auto">
        <div class="text-center mb-10">
            <h2 class="stitch-font text-3xl sm:text-5xl text-cyan-300 mb-2">
                Party Event Details 🌴
            </h2>
            <p class="text-blue-200 text-sm sm:text-base">Everything you need to know about the big day!</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Date Card -->
            <div class="card-glass p-6 rounded-3xl text-center stitch-blue-glow hover:border-cyan-400 transition">
                <div class="w-14 h-14 bg-blue-600/40 border border-cyan-400/40 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">
                    📅
                </div>
                <h3 class="stitch-font text-xl text-cyan-200 mb-1">DATE</h3>
                <p class="heading-font text-2xl font-bold text-white">September 15</p>
                <p class="text-xs text-blue-300 mt-1">Mark your calendar!</p>
            </div>

            <!-- Time Card -->
            <div class="card-glass p-6 rounded-3xl text-center stitch-blue-glow hover:border-cyan-400 transition">
                <div class="w-14 h-14 bg-blue-600/40 border border-cyan-400/40 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">
                    ⏰
                </div>
                <h3 class="stitch-font text-xl text-cyan-200 mb-1">TIME</h3>
                <p class="heading-font text-2xl font-bold text-white">2:00 PM</p>
                <p class="text-xs text-blue-300 mt-1">Afternoon fun & games</p>
            </div>

            <!-- Location Card -->
            <div class="card-glass p-6 rounded-3xl text-center stitch-blue-glow hover:border-cyan-400 transition">
                <div class="w-14 h-14 bg-blue-600/40 border border-cyan-400/40 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">
                    📍
                </div>
                <h3 class="stitch-font text-xl text-cyan-200 mb-1">LOCATION</h3>
                <p class="heading-font text-2xl font-bold text-white">Beaulieu</p>
                <p class="text-xs text-blue-300 mt-1">Stitch Paradise Park</p>
            </div>
        </div>

        <!-- Schedule / Program -->
        <div class="mt-12 card-glass p-6 sm:p-8 rounded-3xl border border-cyan-400/30">
            <h3 class="stitch-font text-2xl text-cyan-300 mb-6 text-center">
                ✨ Hawaiian Party Program ✨
            </h3>
            <div class="space-y-4 max-w-md mx-auto text-sm sm:text-base">
                <div class="flex items-center gap-4 bg-blue-950/50 p-3 rounded-xl border border-cyan-500/20">
                    <span class="stitch-font text-cyan-300 font-bold w-20">2:00 PM</span>
                    <span class="text-blue-100">Aloha Welcome & Lei Greeting 🌺</span>
                </div>
                <div class="flex items-center gap-4 bg-blue-950/50 p-3 rounded-xl border border-cyan-500/20">
                    <span class="stitch-font text-cyan-300 font-bold w-20">3:00 PM</span>
                    <span class="text-blue-100"> Cake Cutting and singing 🎂</span>
                </div>
                <div class="flex items-center gap-4 bg-blue-950/50 p-3 rounded-xl border border-cyan-500/20">
                    <span class="stitch-font text-cyan-300 font-bold w-20">4:30 PM</span>
                    <span class="text-blue-100">snacks and juice time 🍍</span>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="py-8 text-center text-xs text-blue-400/70 border-t border-cyan-500/20 no-print">
        <p>Disney Stitch Inspired Birthday Invitation • Made for Maniloo 💙</p>
    </footer>

    <!-- AUDIO ELEMENT (Hawaiian Tropical Vibe) -->
    <audio id="bgAudio" loop preload="none">
        <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=ukulele-beach-112191.mp3" type="audio/mpeg">
    </audio>

    <!-- SCRIPTS -->
    <script>
        // Falling Hibiscus Petal FX
        const createPetals = () => {
            const container = document.getElementById('petals-container');
            const petals = ['🌺', '🌸', '🌴', '💧'];
            for (let i = 0; i < 15; i++) {
                const petal = document.createElement('div');
                petal.className = 'petal text-xl';
                petal.innerText = petals[Math.floor(Math.random() * petals.length)];
                petal.style.left = Math.random() * 100 + 'vw';
                petal.style.animationDuration = (Math.random() * 5 + 5) + 's';
                petal.style.animationDelay = Math.random() * 5 + 's';
                container.appendChild(petal);
            }
        };
        createPetals();

        // Audio Toggle Logic
        let isPlaying = false;
        const toggleAudio = () => {
            const audio = document.getElementById('bgAudio');
            const icon = document.getElementById('musicIcon');
            const text = document.getElementById('musicText');
            
            if (isPlaying) {
                audio.pause();
                icon.innerText = '🎵';
                text.innerText = 'Play Beach Vibes';
            } else {
                audio.play().catch(() => {});
                icon.innerText = '🔊';
                text.innerText = 'Mute Beach Vibes';
            }
            isPlaying = !isPlaying;
        };

        // Live Countdown Timer logic for September 15th
        const initCountdown = () => {
            const now = new Date();
            let currentYear = now.getFullYear();
            let partyDate = new Date(`September 15, ${currentYear} 14:00:00`);
            
            if (now > partyDate) {
                partyDate = new Date(`September 15, ${currentYear + 1} 14:00:00`);
            }

            const updateTimer = () => {
                const currentTime = new Date();
                const diff = partyDate - currentTime;

                if (diff <= 0) return;

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
                const mins = Math.floor((diff / 1000 / 60) % 60);
                const secs = Math.floor((diff / 1000) % 60);

                document.getElementById('cd-days').innerText = days.toString().padStart(2, '0');
                document.getElementById('cd-hours').innerText = hours.toString().padStart(2, '0');
                document.getElementById('cd-mins').innerText = mins.toString().padStart(2, '0');
                document.getElementById('cd-secs').innerText = secs.toString().padStart(2, '0');
            };

            updateTimer();
            setInterval(updateTimer, 1000);
        };
        initCountdown();
    </script>
</body>
</html>

